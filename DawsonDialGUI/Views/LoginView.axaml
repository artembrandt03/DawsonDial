<UserControl x:Class="DawsonDialGUI.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DawsonDialGUI.ViewModels" x:DataType="vm:MainWindowViewModel" mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <!-- Header -->
                    <TextBlock Text="Login" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <!-- Input Fields -->
                    <TextBox Classes="form" Text="{Binding Username}" Watermark="Username" />
                    <TextBox Classes="form" PasswordChar="*" Text="{Binding Password}"
                        Watermark="Password" />

                    <!-- Error Message -->
                    <TextBlock Foreground="Red" HorizontalAlignment="Center"
                        Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

                    <!-- Actions -->
                    <Button Classes="menu" Content="Login" Command="{Binding LoginCommand}" />
                    <Button Classes="menu" Content="Register"
                        Command="{Binding ShowRegisterViewCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>