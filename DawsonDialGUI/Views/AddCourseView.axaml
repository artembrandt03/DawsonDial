<UserControl x:Class="DawsonDialGUI.Views.AddCourseView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:AddCourseViewModel">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Width="550"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20">

                <StackPanel Spacing="15">
                    <TextBlock Text="Add Course" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>

                    <TextBlock Text="Course Code:" Foreground="LightGray"/>
                    <TextBox Text="{Binding CourseCode}" Classes="menu"/>

                    <TextBlock Text="Subject:" Foreground="LightGray"/>
                    <TextBox Text="{Binding Subject}" Classes="menu"/>

                    <TextBlock Text="Section Number:" Foreground="LightGray"/>
                    <TextBox Text="{Binding SectionNumber}" Classes="menu"/>

                    <!-- <TextBlock Text="Semester:" Foreground="LightGray"/>
                    <TextBox Text="{Binding Semester}" Classes="menu"/> -->

                    <TextBlock Text="Start Date:" Foreground="LightGray"/>
                    <DatePicker SelectedDate="{Binding StartDateUI}" Classes="menu"/>

                    <TextBlock Text="End Date:" Foreground="LightGray"/>
                    <DatePicker SelectedDate="{Binding EndDateUI}" Classes="menu"/>

                    <TextBlock Text="Weekly Schedule:" Foreground="LightGray"/>
                    <ItemsControl ItemsSource="{Binding DaySlots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding Day}" Width="100"/>
                                    <TextBlock Text="Start:" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox Text="{Binding StartTime}" Width="60"/>
                                    <TextBlock Text="End:" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBox Text="{Binding EndTime}" Width="60"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Assign Teacher:" Foreground="LightGray"/>
                    <ComboBox ItemsSource="{Binding Teachers}"
                            SelectedItem="{Binding SelectedTeacher}"
                            Classes="menu">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Username}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Add Course" Command="{Binding SubmitCommand}" Classes="menu"/>
                        <Button Content="Back" Command="{Binding GoBackToMenuCommand}" Classes="menu"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="LightGreen"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="450"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Red"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="450"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
