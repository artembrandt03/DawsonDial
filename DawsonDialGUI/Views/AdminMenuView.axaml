<UserControl x:Class="DawsonDialGUI.Views.AdminMenuView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:AdminMenuViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <!-- Admin Icon -->
                    <Image Source="avares://DawsonDialGUI/Assets/admin-icon.png"
                           Width="40"
                           Height="40"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,0,0,5" />

                    <!-- Menu Buttons -->
                    <StackPanel HorizontalAlignment="Center" Spacing="15">
                        <TextBlock Text="Admin Menu" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />

                        <Button Classes="menu" Content="View Profile" Command="{Binding ViewAdminProfileCommand}" />
                        <Button Classes="menu" Content="View Logs" Command="{Binding ViewLogsCommand}" />
                        <Button Classes="menu" Content="User Menu" Command="{Binding UserMenuCommand}" />
                        <Button Classes="menu" Content="Room Menu" Command="{Binding RoomMenuCommand}" />
                        <Button Classes="menu" Content="Event Menu" Command="{Binding EventMenuCommand}" />
                        <Button Classes="menu" Content="Course Menu" Command="{Binding CourseMenuCommand}" />
                        <Button Classes="menu" Content="Logout" Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>