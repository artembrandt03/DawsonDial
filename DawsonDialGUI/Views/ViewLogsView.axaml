<UserControl x:Class="DawsonDialGUI.Views.ViewLogsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:AdminLogsViewModel">

    <Grid>
        <Border Background="#1E1E1E" CornerRadius="12" Padding="30" BorderBrush="#444" BorderThickness="1" Width="600"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="15">
                <TextBlock Text="Admin Logs" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>

                <ScrollViewer Height="300">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2a2a2a" CornerRadius="6" Padding="10" Margin="0,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp}" Foreground="LightGray"/>
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding Action}" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Content="Back to Menu" Command="{Binding GoBackToMenuCommand}" Classes="menu" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
