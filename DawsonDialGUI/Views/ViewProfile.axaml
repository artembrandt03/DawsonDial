<UserControl x:Class="DawsonDialGUI.Views.ViewProfileView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels" x:DataType="vm:ViewProfileViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500">
                <StackPanel Spacing="20">
                    <!-- Header -->
                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontSize="28"
                        FontWeight="Bold" Foreground="White" />
                    <Border Background="#2A2A2A" CornerRadius="10" Padding="15" Margin="0,0,0,10"
                        BorderBrush="#555" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Basic Info -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Username:" FontWeight="Bold" Foreground="LightGray" />
                                <TextBlock Text="{Binding Username}" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Full Name:" FontWeight="Bold"
                                    Foreground="LightGray" />
                                <TextBlock Text="{Binding FullName}" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding ShowDescription}">
                                <TextBlock Text="Description:" FontWeight="Bold"
                                    Foreground="LightGray" />
                                <TextBlock Text="{Binding Description}" Foreground="White"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Student Fields -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsStudent}">
                                <TextBlock Text="Student ID:" FontWeight="Bold"
                                    Foreground="LightGray" />
                                <TextBlock Text="{Binding StudentId}" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsStudent}">
                                <TextBlock Text="Program:" FontWeight="Bold" Foreground="LightGray" />
                                <TextBlock Text="{Binding Program}" Foreground="White" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsStudent}">
                                <TextBlock Text="Year:" FontWeight="Bold" Foreground="LightGray" />
                                <TextBlock Text="{Binding Year}" Foreground="White" />
                            </StackPanel>

                            <!-- Teacher Fields -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsTeacher}">
                                <TextBlock Text="Department:" FontWeight="Bold"
                                    Foreground="LightGray" />
                                <TextBlock Text="{Binding Department}" Foreground="White" />
                            </StackPanel>

                            <!-- Admin Fields -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding IsAdmin}">
                                <TextBlock Text="Users Created:" FontWeight="Bold"
                                    Foreground="LightGray" />
                                <TextBlock Text="{Binding CreatedUsers}" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="15" Margin="0,40,0,0">
                        <Button Classes="menu" Content="Update Profile"
                            Command="{Binding NavigateToUpdateProfileCommand}"
                            HorizontalAlignment="Center" />
                        <Button Classes="menu" Content="Change Password"
                            Command="{Binding NavigateToChangePasswordCommand}"
                            HorizontalAlignment="Center" />
                        <Button Classes="menu" Content="Back to Menu"
                            Command="{Binding GoBackToMenuCommand}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Error message -->
                    <TextBlock Foreground="Green" HorizontalAlignment="Center"
                        Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                    <TextBlock Foreground="Red" HorizontalAlignment="Center"
                        Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>