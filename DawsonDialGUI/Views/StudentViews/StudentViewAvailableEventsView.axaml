<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:StudentViewAvailableEventsViewModel"
             x:Class="DawsonDialGUI.Views.StudentViewAvailableEventsView">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20">
                <Button Classes="menu" Content="Back" Command="{Binding GoBackToMenuCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="Available Events" FontSize="24" FontWeight="Bold" Margin="0,20,0,10" />
            </StackPanel>            
            
            <!-- Error Message -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            
            <ItemsControl Grid.Row="1" ItemsSource="{Binding AvailableConference}" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10"
                                BorderBrush="#444"
                                BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                                           
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                    <TextBlock Text="Location:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Room.RoomNumber}"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Date:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StartDateTime, StringFormat='{}{0:d}'}"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Time:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StartDateTime, StringFormat='{}{0:t}'}"/>
                                    <TextBlock Text="to"/>
                                    <TextBlock Text="{Binding EndDateTime, StringFormat='{}{0:t}'}"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Available Seats:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AvailableSeats}"/>
                                    <TextBlock Text="of"/>
                                    <TextBlock Text="{Binding MaxCapacity}"/>
                                </StackPanel>
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Status:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}"/>
                                </StackPanel>
                                
                                <!-- Conference-specific information -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                    <TextBlock Text="Speaker:" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Speaker.FirstName}"/>
                                    <TextBlock Text="{Binding Speaker.LastName}"/>
                                </StackPanel>
                                
                                <!-- Register Button -->
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
</UserControl>