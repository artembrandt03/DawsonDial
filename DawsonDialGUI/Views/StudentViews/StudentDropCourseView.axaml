<UserControl x:Class="DawsonDialGUI.Views.StudentDropCourseView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DawsonDialGUI.ViewModels"
    xmlns:models="using:DawsonDial.Models.Events"
    mc:Ignorable="d"
    x:DataType="vm:StudentDropCourseViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20">
                <Button Classes="menu" Content="Back to Menu" Command="{Binding GoBackToMenuCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="Drop Course" FontSize="24" FontWeight="Bold" Margin="0,20,0,10" />
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <ItemsControl Grid.Row="1" ItemsSource="{Binding EnrolledCourses}" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Section">
                        <Border Background="#1E1E1E"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10"
                                BorderBrush="#444"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="{Binding Course.Subject}"
                                             FontSize="18"
                                             FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Course.CourseCode}"
                                             FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" 
                                              Spacing="10" 
                                              Margin="0,5,0,0">
                                        <TextBlock Text="{Binding SectionNumber, StringFormat='Section {0}'}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Teacher.FirstName}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Teacher.LastName}"
                                                 VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Content="Drop"
                                        Command="{Binding ((vm:StudentDropCourseViewModel)DataContext).DropCourseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Classes="danger"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>