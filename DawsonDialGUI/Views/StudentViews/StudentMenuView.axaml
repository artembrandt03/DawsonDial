<UserControl x:Class="DawsonDialGUI.Views.StudentViews.StudentMenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels" x:DataType="vm:StudentMenuViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="700">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <TextBlock Text="Student Menu" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <Button Classes="menu" Width="400" Content="View Profile"
                        Command="{Binding ViewStudentProfileCommand}" />                    
                    <Button Classes="menu" Width="400" Content="View Available Courses"
                        Command="{Binding ViewAvailableCoursesCommand}" />
                    <Button Classes="menu" Width="400" Content="View My Courses"
                        Command="{Binding ViewMyCoursesCommand}" />
                    <Button Classes="menu" Width="400" Content="Enroll in Course"
                        Command="{Binding EnrollInCourseCommand}" />
                    <Button Classes="menu" Width="400" Content="Drop Course"
                        Command="{Binding DropCourseCommand}" />
                    <Button Classes="menu" Width="400" Content="View Available Conferences"
                        Command="{Binding ViewAvailableEventsCommand}" />
                    <Button Classes="menu" Width="400" Content="Book Teacher Meeting"
                        Command="{Binding BookTeacherMeetingCommand}" />
                    <Button Classes="menu" Width="400" Content="View My Conferences"
                        Command="{Binding ViewMyEventsCommand}" />
                    <Button Classes="menu" Width="400" Content="View My Teacher Meetings"
                        Command="{Binding ViewMyTeacherMeetingsCommand}" />
                    <Button Classes="menu" Width="400" Content="View My Schedule"
                        Command="{Binding ViewMyScheduleCommand}" />
                    <Button Classes="menu" Width="400" Content="Logout" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>