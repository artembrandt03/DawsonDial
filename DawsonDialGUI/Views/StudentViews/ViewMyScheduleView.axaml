<UserControl x:Class="DawsonDialGUI.Views.StudentViews.ViewMyScheduleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.StudentViewModels" x:DataType="vm:ViewMyScheduleViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30,40"
                BorderBrush="#444" BorderThickness="1" Width="500">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <TextBlock Text="My Schedule" FontSize="24" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="{Binding DateRangeText}" FontSize="14"
                        HorizontalAlignment="Center" Foreground="#CCCCCC" />
                    <DataGrid ItemsSource="{Binding TimeSlots}" AutoGenerateColumns="False"
                        HeadersVisibility="Column" GridLinesVisibility="All"
                        CanUserResizeColumns="False" CanUserSortColumns="False" Margin="0,10,0,0"
                        Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekString}"
                                Width="*" />
                            <DataGridTextColumn Header="Start Time"
                                Binding="{Binding StartTimeString}" Width="*" />
                            <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeString}"
                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Back to Menu"
                            Command="{Binding GoBackToMenuCommand}" Classes="menu" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
