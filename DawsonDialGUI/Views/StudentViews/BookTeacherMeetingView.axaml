<UserControl x:Class="DawsonDialGUI.Views.StudentViews.BookTeacherMeetingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.StudentViewModels"
    xmlns:models="using:DawsonDial.Models.People"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="vm:BookTeacherMeetingViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="700">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <TextBlock Text="Book Teacher Meeting" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />
                      <!-- Teacher Selection -->
                    <TextBlock Text="Select a Teacher:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AvailableTeachers}"
                        SelectedItem="{Binding SelectedTeacher}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Teacher">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName" />
                                            <Binding Path="LastName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Meeting Topic -->
                    <TextBlock Text="Meeting Topic:" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <TextBox Text="{Binding Topic}"
                        Watermark="Enter the topic of your meeting"
                        Classes="clearButton"
                        Width="400" />

                    <!-- Meeting Description -->
                    <TextBlock Text="Meeting Description:" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <TextBox Text="{Binding Description}"
                        Watermark="Describe what you'd like to discuss"
                        Classes="clearButton"
                        Height="100"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Width="400" />                    <!-- Meeting Date -->
                    <TextBlock Text="Select a Date:" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <CalendarDatePicker SelectedDate="{Binding MeetingDate, Mode=TwoWay}"
                        HorizontalAlignment="Center"
                        Width="400" />

                    <!-- Meeting Time -->
                    <TextBlock Text="Select a Time:" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <TimePicker SelectedTime="{Binding StartTime}"
                        ClockIdentifier="24HourClock"
                        MinuteIncrement="15"
                        Width="400" />

                    <!-- Duration -->
                    <TextBlock Text="Meeting Duration:" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <NumericUpDown Value="{Binding DurationMinutes}"
                        Minimum="15"
                        Maximum="60"
                        Increment="15"
                        Width="400"
                        Watermark="Select duration in minutes" />

                    <!-- Messages -->
                    <TextBlock Text="{Binding ErrorMessage}"
                        Foreground="Red"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}"
                        Foreground="Green"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />

                    <!-- Buttons -->
                    <Button Classes="menu"
                        Content="Book Meeting"
                        Command="{Binding BookMeetingCommand}"
                        IsEnabled="{Binding IsBookingEnabled}"
                        Width="400" />
                    <Button Classes="menu"
                        Content="Back to Menu"
                        Command="{Binding GoBackCommand}"
                        Width="400" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
