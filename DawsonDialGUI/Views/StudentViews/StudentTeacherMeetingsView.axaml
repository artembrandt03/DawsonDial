<UserControl x:Class="DawsonDialGUI.Views.StudentViews.StudentTeacherMeetingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.StudentViewModels"
    x:DataType="vm:StudentTeacherMeetingsViewModel">    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="900">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}" 
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <!-- Show message if no meetings -->
                    <TextBlock Text="You have no upcoming meetings." FontSize="16"
                        Foreground="#CCCCCC"
                        IsVisible="{Binding !TeacherMeetings.Count}" HorizontalAlignment="Center" />

                    <!-- Meetings DataGrid -->
                    <DataGrid ItemsSource="{Binding TeacherMeetings}"
                        AutoGenerateColumns="False" HeadersVisibility="Column"
                        GridLinesVisibility="All"
                        CanUserResizeColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                        Margin="0,10,0,0" Height="300" Background="#2D2D2D" Foreground="White"
                        IsVisible="{Binding TeacherMeetings.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}"
                                Width="1.5*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="Teacher" Binding="{Binding TeacherName}"
                                Width="1.2*" SortMemberPath="TeacherName" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}"
                                Width="*" SortMemberPath="SortableDate" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}"
                                Width="*" SortMemberPath="SortableTime" />
                            <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}"
                                Width="0.7*" />
                            <DataGridTextColumn Header="Attendees"
                                Binding="{Binding ParticipantCount}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Refresh Meetings" Command="{Binding RefreshMeetingsCommand}"
                            Classes="menu" />
                        <Button Content="Back to Menu" Command="{Binding GoBackCommand}"
                            Classes="menu" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
