<UserControl x:Class="DawsonDialGUI.Views.TeacherViews.TeacherSectionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels"
    xmlns:model="using:DawsonDial.Models.Events"
    x:DataType="vm:TeacherSectionsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500" VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Text="Your Sections" FontSize="24" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:Section">
                                <Border Background="#2A2A2A" CornerRadius="10" Padding="15"
                                    Margin="0,0,0,10" BorderBrush="#555" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Course.Subject}" FontWeight="Bold"
                                            FontSize="16" Foreground="#DDDDDD" />
                                        <TextBlock Text="{Binding Course.CourseCode}" FontSize="14"
                                            Foreground="#CCCCCC" />
                                        <TextBlock
                                            Text="{Binding SectionNumber, StringFormat='Section: {0}'}"
                                            FontSize="13" Foreground="LightGray" />
                                        <TextBlock
                                            Text="{Binding EnrolledStudents.Count, StringFormat='Students: {0}'}"
                                            FontSize="13" Foreground="LightGray" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="menu" Content="Back to Menu"
                        Command="{Binding GoBackToMenuCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>