<UserControl x:Class="DawsonDialGUI.Views.TeacherViews.ViewAllEventsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels" x:DataType="vm:ViewAllEventsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30,40"
                BorderBrush="#444" BorderThickness="1" Width="900">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <!-- Show message if no events -->
                    <TextBlock Text="There are no upcoming events." FontSize="16"
                        Foreground="#CCCCCC" IsVisible="{Binding !AvailableEvents.Count}"
                        HorizontalAlignment="Center" />

                    <!-- Events DataGrid -->
                    <DataGrid Name="EventsGrid" ItemsSource="{Binding AvailableEvents}"
                        AutoGenerateColumns="False" HeadersVisibility="Column"
                        GridLinesVisibility="All" CanUserResizeColumns="False"
                        CanUserSortColumns="True" IsReadOnly="True" Margin="0,10,0,0" Height="300"
                        Background="#2D2D2D" Foreground="White"
                        IsVisible="{Binding AvailableEvents.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}"
                                Width="1.5*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*"
                                SortMemberPath="TypeName" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}"
                                Width="1.2*" SortMemberPath="SortableDate" />
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="*"
                                SortMemberPath="SortableTime" />
                            <DataGridTextColumn Header="Room" Binding="{Binding RoomNumber}"
                                Width="*" SortMemberPath="RoomNumber" />
                            <DataGridTextColumn Header="Capacity"
                                Binding="{Binding ParticipantCount}" Width="*"
                                SortMemberPath="ParticipantCount" />

                            <!-- Actions column -->
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Register"
                                            Command="{Binding RegisterCommand}"
                                            IsVisible="{Binding CanRegister}" Background="#336633"
                                            Foreground="White" Padding="8,4" Margin="4"
                                            CornerRadius="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Refresh Events" Command="{Binding RefreshEventsCommand}"
                            Classes="menu" />
                        <Button Content="Back to Events Menu"
                            Command="{Binding GoBackToEventMenuCommand}" Classes="menu" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl> 