<UserControl x:Class="DawsonDialGUI.Views.TeacherViews.TeacherEventsMenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels"
    x:DataType="vm:TeacherEventsMenuViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- Events submenu border and layout -->
            <Border Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500" VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Text="Events" FontSize="24" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />
                    <!-- Events options -->
                    <Button Classes="menu" Content="View My Events"
                        Command="{Binding ViewMyEventsCommand}" />
                    <Button Classes="menu" Content="View All Events"
                        Command="{Binding ViewAllEventsCommand}" />
                    <!-- Back navigation -->
                    <Button Classes="menu" Content="Back to Menu"
                        Command="{Binding GoBackToMenuCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl> 