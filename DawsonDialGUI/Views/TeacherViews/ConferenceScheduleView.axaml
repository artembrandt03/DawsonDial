<UserControl
    x:Class="DawsonDialGUI.Views.TeacherViews.ConferenceScheduleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels"
    x:DataType="vm:ConferenceScheduleViewModel"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="1"
                MaxWidth="600"
                Margin="20"
                HorizontalAlignment="Center">
                <Border
                    Width="500"
                    Padding="30"
                    Background="#1E1E1E"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" Spacing="15">

                        <!--  Header  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Schedule a Conference" />

                        <!--  Input Fields  -->
                        <TextBox
                            Classes="form"
                            Text="{Binding Title}"
                            Watermark="Title" />
                        <TextBox
                            Classes="form"
                            Text="{Binding Description}"
                            Watermark="Description" />

                        <!--  Date + Time Pickers  -->
                        <StackPanel Spacing="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Margin="0,10,0,0"
                                FontWeight="Bold"
                                Text="Date:" />
                            <DatePicker
                                HorizontalAlignment="Center"
                                SelectedDate="{Binding Date}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Margin="0,10,0,0"
                                FontWeight="Bold"
                                Text="Start:" />
                            <TimePicker
                                HorizontalAlignment="Center"
                                SelectedTime="{Binding StartTime}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Margin="0,10,0,0"
                                FontWeight="Bold"
                                Text="End:" />
                            <TimePicker
                                HorizontalAlignment="Center"
                                SelectedTime="{Binding EndTime}" />
                        </StackPanel>

                        <!--  Room Picker  -->
                        <StackPanel IsVisible="{Binding ShowRoomOptions}" Spacing="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Margin="0,10,0,0"
                                FontWeight="Bold"
                                Text="Room:" />
                            <ComboBox
                                Width="240"
                                HorizontalAlignment="Center"
                                ItemsSource="{Binding AvailableRooms}"
                                SelectedItem="{Binding SelectedRoom}" />
                        </StackPanel>

                        <!--  Speaker Info  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            Classes="form"
                            Foreground="Yellow"
                            Margin="0,10,0,0"
                            IsVisible="{Binding HelpMessageVisible}"
                            Text="You will automatically be set as the conference speaker." />

                        <!--  Error Message  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="Red"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="Green"
                            Text="{Binding SuccessMessage}"
                            TextWrapping="Wrap" />

                        <!--  Actions  -->
                        <Button
                            HorizontalAlignment="Center"
                            Classes="menu"
                            Command="{Binding LoadAvailableRoomsCommand}"
                            Content="Check Room Availability" />
                        <Button
                            HorizontalAlignment="Center"
                            Classes="menu"
                            Command="{Binding EventScheduleCommand}"
                            Content="Submit Conference" />
                        <Button
                            HorizontalAlignment="Center"
                            Classes="menu"
                            Command="{Binding GoBackToSchedulingCommand}"
                            Content="Back to Scheduling" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>