<UserControl x:Class="DawsonDialGUI.Views.TeacherViews.SetOfficeHoursView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels"
    x:DataType="vm:SetOfficeHoursViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="600" Margin="20">
                <Border Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="30"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Width="500">
                    <StackPanel Spacing="20">

                        <!-- Title -->
                        <TextBlock Text="Set Office Hours" FontSize="28" FontWeight="Bold"
                            HorizontalAlignment="Center" Foreground="White" />

                        <!-- Dates -->
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <TextBlock HorizontalAlignment="Center" Text="Start Date"
                                Foreground="White" />
                            <DatePicker HorizontalAlignment="Center"
                                SelectedDate="{Binding StartDate}" Classes="form" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <TextBlock HorizontalAlignment="Center" Text="End Date"
                                Foreground="White" />
                            <DatePicker HorizontalAlignment="Center"
                                SelectedDate="{Binding EndDate}" Classes="form" />
                        </StackPanel>

                        <!-- Drop-In Checkbox -->
                        <CheckBox IsChecked="{Binding IsDropIn}" Content="Drop-In Office Hours"
                            Foreground="White" HorizontalAlignment="Center" />

                        <!-- Office Hour Slots -->
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                            Content="{Binding Day}" Foreground="White" />
                                        <StackPanel Orientation="Vertical"
                                            IsVisible="{Binding IsEnabled}" Margin="15,0,0,10"
                                            Spacing="4">
                                            <StackPanel HorizontalAlignment="Center"
                                                Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Start:" Foreground="White"
                                                    VerticalAlignment="Center" Classes="form" />
                                                <TimePicker SelectedTime="{Binding StartTime}"
                                                    Width="240" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center"
                                                Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="End:  " Foreground="White"
                                                    VerticalAlignment="Center" Classes="form" />
                                                <TimePicker SelectedTime="{Binding EndTime}"
                                                    Width="240" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Feedback -->
                        <TextBlock Foreground="Red" Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <TextBlock Foreground="Green" Text="{Binding SuccessMessage}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" />

                        <!-- Buttons -->
                        <Button Content="Submit Office Hours" Command="{Binding SubmitCommand}"
                            Classes="menu" />
                        <Button Content="Back to Scheduling"
                            Command="{Binding GoBackToSchedulingCommand}" Classes="menu" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>