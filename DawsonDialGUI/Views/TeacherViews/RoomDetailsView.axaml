<UserControl
    x:Class="DawsonDialGUI.Views.TeacherViews.RoomDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels.TeacherViewModels"
    x:DataType="vm:RoomDetailsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="1"
            Width="500"
            Padding="30"
            Background="#1E1E1E"
            BorderBrush="#444"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="20">
                <!--  Header  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Title}" />

                <Border
                    Margin="0,0,0,10"
                    Padding="15"
                    Background="#2A2A2A"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Spacing="10">
                        <!--  Basic Info  -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Foreground="White" Text="{Binding RoomType}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Foreground="White" Text="{Binding HasProjector}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Foreground="White" Text="{Binding HasComputers}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Foreground="White"
                                Text="{Binding NumberOfSeats}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Center"
                            Classes="menu"
                            Command="{Binding NavigateBackCommand}"
                            Content="Go Back" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
