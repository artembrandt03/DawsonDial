<UserControl x:Class="DawsonDialGUI.Views.RegisterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DawsonDialGUI.ViewModels" 
    x:DataType="vm:MainWindowViewModel" 
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <!-- Header -->
                    <TextBlock Text="Register" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <!-- Input Fields -->
                    <TextBox Classes="form" Text="{Binding Username}" Watermark="Username" />
                    <TextBox Classes="form" PasswordChar="*" Text="{Binding Password}"
                        Watermark="Password" />
                    <TextBox Classes="form" PasswordChar="*" Text="{Binding ConfirmPassword}"
                        Watermark="Confirm Password" />
                    <TextBox Classes="form" Text="{Binding FirstName}" Watermark="First Name" />
                    <TextBox Classes="form" Text="{Binding LastName}" Watermark="Last Name" />
                    <TextBox Classes="form" Text="{Binding Age}" Watermark="Age" />
                    <TextBox Classes="form" Text="{Binding StudentId}" Watermark="Student ID" />
                    <TextBox Classes="form" Text="{Binding Program}" Watermark="Program" />
                    <TextBox Classes="form" Text="{Binding Year}" Watermark="Year" />

                    <!-- Error Message -->
                    <TextBlock Foreground="Red" HorizontalAlignment="Center"
                        Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

                    <!-- Actions -->
                    <Button Classes="menu" Command="{Binding RegisterCommand}" Content="Submit"
                        HorizontalAlignment="Center" />
                    <Button Classes="menu" Command="{Binding ShowLoginViewCommand}"
                        Content="Back to Login" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>