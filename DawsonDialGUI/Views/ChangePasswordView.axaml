<UserControl x:Class="DawsonDialGUI.Views.ChangePasswordView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DawsonDialGUI.ViewModels" x:DataType="vm:ChangePasswordViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="12" Padding="30"
                BorderBrush="#444" BorderThickness="1" Width="500">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <TextBlock Text="Change Password" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" Foreground="White" />

                    <TextBox Classes="form" Watermark="Current Password" PasswordChar="*"
                        Text="{Binding CurrentPassword}" />
                    <TextBox Classes="form" Watermark="New Password" PasswordChar="*"
                        Text="{Binding NewPassword}" />
                    <TextBox Classes="form" Watermark="Confirm Password" PasswordChar="*"
                        Text="{Binding ConfirmPassword}" />

                    <TextBlock Foreground="Red" HorizontalAlignment="Center"
                        Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

                    <Button Classes="menu" Content="Submit Password"
                        Command="{Binding SubmitPasswordChangeCommand}" />
                    <Button Classes="menu" Content="Back to Profile"
                        Command="{Binding NavigateToProfileCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>