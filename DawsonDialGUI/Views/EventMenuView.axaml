<UserControl x:Class="DawsonDialGUI.Views.EventMenuView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:EventMenuViewModel">
    
    <Grid>
        <Border Background="#1E1E1E"
                CornerRadius="12"
                Padding="30"
                BorderBrush="#444"
                BorderThickness="1"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="15">
                <TextBlock Text="⚠ The event module is still under development."
                    Foreground="OrangeRed"
                    FontWeight="Bold"
                    FontSize="14"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"/>
                <TextBlock Text="Event Menu"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="White" />

                <Button Content="View All Events"
                        Command="{Binding ViewAllEventsCommand}"
                        Classes="menu" />

                <Button Content="Add Event"
                        Command="{Binding AddEventCommand}"
                        Classes="menu" />

                <Button Content="Back to Menu"
                        Command="{Binding GoBackToMenuCommand}"
                        Classes="menu" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>