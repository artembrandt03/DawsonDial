<UserControl x:Class="DawsonDialGUI.Views.CourseMenuView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DawsonDialGUI.ViewModels"
             x:DataType="vm:CourseMenuViewModel">
    
    <Grid>
        <Border Background="#1E1E1E"
                CornerRadius="12"
                Padding="30"
                BorderBrush="#444"
                BorderThickness="1"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="15">
                <TextBlock Text="Course Menu"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="White" />

                <!-- Buttons -->
                <Button Content="View All Courses"
                        Command="{Binding ViewAllCoursesCommand}"
                        Classes="menu" />

                <Button Content="Add Course"
                        Command="{Binding AddCourseCommand}"
                        Classes="menu" />

                <Button Content="Back to Menu"
                        Command="{Binding GoBackToMenuCommand}"
                        Classes="menu" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>